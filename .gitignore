# Dependencies & builds
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/

# AiderDesk deployment marker
.deployed-version

# Broke runtime data (per-task stats log, measurement ledger)
stats.jsonl
measure.jsonl
# Runtime settings next to index.ts (deploy.ps1 keeps it in the install dir)
config.json
# F3 snapshot history (per-task JSON records written by snapshot.ts)
snapshots/

.aider*

# Release signing private key (NEVER commit - goes into the BROKE_RELEASE_SIGNING_KEY repo secret)
broke-release-signing-key.pem
SHA256SUMS*

# Release working files: GitHub API payloads and downloaded release archives.
# Everything committed in a tag gets signed, published and installed by
# /broke update, so a scratch file must never end up there (the v1.2.2 tag
# shipped a stale release-payload.json for v1.2.1 this way). Release notes
# are generated with `gh release create --generate-notes`.
release-payload*.json
*.tar.gz

# Local tooling indexes (CodeGraph) - never part of the extension
.codegraph/

# Agent scratch plans (plan.md / todo.md) are working notes for the
# maintainer, not part of the published extension or its docs.
tasks/
